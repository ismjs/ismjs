{
  "compilerOptions": {
    "target": "ES2022",
    // ES2023 for the non-mutating array methods (toSorted). The package requires
    // Node 24 or newer, where these methods are available.
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,

    // Types must be erasable: Node runs the scripts/ files directly by stripping
    // types, and this also rules out `enum`, which the previous implementation
    // leaned on heavily. Const objects plus union types tree-shake; enums do not.
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // A key an index signature admits may be absent, so read it as `x['key']`.
    // Dot access is kept for properties the type declares.
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "declaration": true,
    // Every export states its type, so each file's declarations can be written
    // without the type checker. tsdown sees this and emits the .d.ts files with
    // oxc. A `satisfies` check on an export goes in its own statement, because
    // the type cannot be read through `as const satisfies`.
    "isolatedDeclarations": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "pretty": true
  }
}
