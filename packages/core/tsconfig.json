{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `scripts/` imports node builtins and `node scripts/codegen.ts` runs them.
    // The repo-root config picks `@types/node` up automatically; this one does
    // not, because automatic `@types` discovery does not reach the hoisted
    // `node_modules` from here. Named explicitly so the editor — which resolves
    // the nearest tsconfig, this one — agrees with `bun run typecheck`.
    "types": ["node"]
  },
  "include": ["src", "test", "scripts", "tsdown.config.ts"]
}
