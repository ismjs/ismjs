{
  "name": "ismjs-monorepo",
  "private": true,
  "description": "Workspace root for the ismjs packages. The publishable code lives in packages/.",
  "homepage": "https://github.com/ismjs/ismjs#readme",
  "license": "MIT",
  "author": {
    "name": "Justin Williams",
    "url": "https://github.com/nerdstep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismjs/ismjs.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "codegen": "bun run --filter @ismjs/core codegen",
    "harvest": "bun run --filter @ismjs/core harvest",
    "build": "bun run --filter '*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test",
    "check:generated": "bun run codegen && node packages/core/scripts/check-drift.ts 'packages/*/src/generated'",
    "check:corpus": "bun run harvest && node packages/core/scripts/check-drift.ts 'packages/*/test/fixtures'",
    "check:full": "bun run build && bun run fmt:check && bun run lint && bun run typecheck && bun run test:coverage && bun run check:generated && bun run check:corpus && bun run check:package",
    "check:package": "bun run --filter '*' check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "fast-xml-parser": "^5.10.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
